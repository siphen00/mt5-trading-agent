# Copy this file to .env on the machine running the MT5 connector.
# .env is gitignored — never commit real credentials.

MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:\Program Files\Your Broker MT5\terminal64.exe

# Only needed for the weekly deep-dive journal (GitHub Actions secret, not local .env)
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you want the connector itself to push commits
# (fine-grained PAT scoped to Contents: read/write on this repo only)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-username/mt5-trading-agent
