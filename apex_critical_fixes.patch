+// Mirror of strategy/signals.py atr_filter_ok: skip when current ATR is below
+// its 20-period average (the low-volatility chop filter).
+function atrFilterOk(atr14, i, period=20, minMultiplier=1.0){
+  if(i < period) return true;            // not enough data yet — don't block
+  const cur = atr14[i];
+  if(!cur) return true;
+  let sum = 0, n = 0;
+  for(let j=i-period+1;j<=i;j++){ if(atr14[j]){ sum += atr14[j]; n++; } }
+  if(!n) return true;
+  return cur >= (sum/n) * minMultiplier;
+}
